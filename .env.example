# ==========================================
# Legal AI HIL Pipeline Configuration
# ==========================================

# LLM Provider Configuration
# Choose: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (recommended for Ethiopian scripts & multimodality)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional alternative)
# Get yours at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Pipeline Execution Settings
# When True, if no API key is provided, the pipeline gracefully uses
# high-quality offline extraction and pre-indexed ground truth data from w1/w2/civils
FALLBACK_TO_LOCAL_OCR=True
MAX_PAGES_PER_BATCH=5
SCORE_THRESHOLD=95
